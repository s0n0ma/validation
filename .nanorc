# ================== БАЗОВЫЕ НАСТРОЙКИ ==================
set linenumbers       # Отображение номеров строк
set constantshow      # Постоянно показывает позицию курсора
set tabsize 4         # Ширина табуляции 4 пробела

# Автоотступ при переходе на новую строку
# При переходе на новую строку (по Enter) автоматически
# повторяет отступ предыдущей строки
set autoindent

set positionlog       # Запоминание позиции курсора между сеансами

# История открываемых файлов и поисковых запросов
# Сохраняет историю открываемых файлов между сеансами работы nano.
# При использовании Ctrl+R (Вставить файл) или Ctrl+O (Сохранить как)
# вы увидите список недавно открывавшихся файлов
set historylog

# Home сначала на первый символ, потом в начало
# Клавиша Home будет переводить курсор не всегда в начало строки, а сначала
# на первый не-пробельный символ, а потом уже в самое начало.
# Очень удобно при работе с кодом
set smarthome

set mouse             # Поддержка мыши (выделение, скролл, клик)
set casesensitive     # Поиск чувствительный к регистру (важно для кода)

# Вертикальный скроллбар справа
# Добавляет тонкий вертикальный «скроллбар» справа - помогает понять,
# где вы находитесь в длинном файле, без прокрутки наугад
set indicator

# Преобразует нажатия клавиши Tab в соответствующее количество пробелов.
# Полезно при работе с YAML и Python.
# УБРАНО! Для Bash-скриптов нужны табы, а не пробелы!
# set tabstospaces

# ================== ПЕРЕНОС СТРОК ==================
# Мягкий перенос длинных строк
# Включает перенос длинных строк на следующую строку
# в отображении (без добавления реальных символов новой строки в файл)
set softwrap

# Мягкий перенос только по пробелам/табам
# Уточняет, где именно делать мягкий перенос -
# только между словами (пробелами/табуляциями)
set atblanks

# ================== ПОВЕДЕНИЕ И КОДИНГ ==================
set multibuffer       # Открывать несколько файлов в разных буферах
set cutfromcursor     # Ctrl+K вырезает от курсора до конца строки
set zap               # Удаление выделенного текста клавишами Backspace/Del
set boldtext          # Делает текст и UI более контрастным

# ================== ЦВЕТА ИНТЕРФЕЙСА ==================
set titlecolor bold,white,blue      # Цвет верхней строки
set statuscolor bold,white,blue     # Цвет нижней строки состояния
set numbercolor cyan                # Цвет номеров строк
set selectedcolor bold,black,yellow # Цвет выделенного текста

# ================== БЕЗОПАСНОСТЬ ==================
# Создает резервную копию файла с суффиксом ~ при сохранении
# set backup
# Указывает директорию, в которую будут сохраняться резервные копии,
# вместо текущей директории
# (необходимо самому создать её командой: mkdir -p ~/.nano_backups)
# set backupdir "~/.nano_backups/"

# ================== ИНОЕ ==================
# Включает использование регулярных выражений (POSIX-совместимых)
# в поиске и замене. Осторожно! Это меняет поведение по умолчанию
# set regexp

# Не добавляет автоматически символ новой строки в конец файла,
# если его там нет.
# set nonewlines

# ================== ПОДСВЕТКА СИНТАКСИСА ==================
# Подсветка синтаксиса.
# Что делает include:
# Загружает правила подсветки для конкретного языка.
# Указывает nano, какие файлы с синтаксисом использовать.
# Без include - nano просто не знает о существовании этих правил.
# Загружаются только указанные языки, меньше потребление памяти.
# Загружаем правила для языков, с которыми ты чаще всего работаешь
# include "/usr/share/nano/bash.nanorc"
# include "/usr/share/nano/sh.nanorc"
# include "/usr/share/nano/python.nanorc"
# include "/usr/share/nano/html.nanorc"
# include "/usr/share/nano/json.nanorc"
# include "/usr/share/nano/yaml.nanorc"
# include "/usr/share/nano/markdown.nanorc"

# Если в твоем дистрибутиве есть папка extra, можно подключить всё сразу:
# include "/usr/share/nano/extra/*.nanorc"

# ================== ШПАРГАЛКА (ВЫУЧИТЬ) ==================
# Ctrl G - Помощь (Help)
# Ctrl X - Выход (Exit)
# Ctrl O - Записать/Сохранить (Write Out)
# Ctrl S - Быстрое сохранение (без запроса имени)
#          (Save File Without Prompting)
# Ctrl R - Вставить файл / Открыть (Read File)
# Ctrl W - Поиск вперёд (Where Is)
# Ctrl Q - Поиск назад / Отмена поиска
# Alt W  - Продолжить поиск
# Ctrl \ - Замена (Replace)
# Alt A  - Начать/снять выделение (Set Mark)
# Alt 6  - Копировать выделенное (Copy)
# Ctrl K - Вырезать строку ИЛИ от курсора до конца (если set cutfromcursor)
# Ctrl U - Вставить (Paste)
# Alt U  - Отмена (Undo)
# Alt E  - Повтор (Redo)
# Ctrl / - Перейти на строку (Go To Line)
# Ctrl ] - Найти парную скобку (To Bracket)
# Alt 3  - Закомментировать/раскомментировать строку (Mark/Unmark string as comment)

# Ctrl C - Отмена (Cancel)
# Ctrl T - Выполнить (Execute)
# Ctrl J - Выровнить (Justify)
